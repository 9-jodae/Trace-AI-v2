# local이어야 /docs, /playground, 샘플 데이터를 쓸 수 있고 인증을 생략한다. 그 외 값은 모두 운영 환경으로 처리한다
APP_ENV=local
# 운영 환경 필수. Spring이 X-Internal-Secret 헤더로 보내는 값
INTERNAL_SECRET=
# true면 샘플 문서로 검색한다 (로컬 전용, 운영 환경에서는 시작 실패)
USE_SAMPLE_DATA=true

# python main.py의 주소. 비워 두면 로컬은 127.0.0.1, 운영은 0.0.0.0, 포트는 8000
HOST=
PORT=

# TypeSafe JEV API 키
JEV_API_KEY=
# 비워 두면 jev-latest 사용
JEV_MODEL=

# 임베딩 모델 (서비스:모델명). Bedrock은 API 키 없이 AWS 자격 증명과 AWS_REGION을 사용
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bedrock:amazon.titan-embed-text-v2:0
# 벡터 저장소의 차원과 같아야 함
EMBEDDING_DIMENSIONS=1024

# LLM 모델 (서비스:모델명). Bedrock은 API 키 없이 AWS 자격 증명 사용
LLM_API_KEY=
LLM_MODEL=
# 선택. LLM_MODEL이 실패하면 한 번 전환할 모델 (같은 LLM_API_KEY 또는 AWS 자격 증명 사용)
LLM_FALLBACK_MODEL=

# 벡터 저장소: qdrant 또는 pgvector. 성능 비교 후 결정하므로 기본값 없음
VECTOR_STORE=
QDRANT_URL=
QDRANT_COLLECTION=
# VECTOR_STORE=pgvector일 때 사용. SSH 터널 시: postgresql://ai_app:비밀번호@localhost:5432/docs199
DATABASE_URL=

# 메모리에 보관할 대화 수와 시간(초). 비워 두면 1000개, 3600초
MAX_CONVERSATIONS=
CONVERSATION_TTL_SECONDS=

# 질문 한 건의 전체 시간 상한(초). 비워 두면 60초. Spring 타임아웃보다 짧게 맞춘다
REQUEST_TIMEOUT_SECONDS=

# 그래프 저장소. SSH 터널 시: bolt://localhost:7687
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# 로컬 시험용 허용 그룹(쉼표 구분). 운영에서는 무시하며, 권한 범위가 없으면 문서를 돌려주지 않는다
ALLOWED_GROUP_IDS=
