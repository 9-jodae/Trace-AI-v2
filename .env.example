# local이어야 /docs, /playground, 샘플 데이터를 쓸 수 있고 인증을 생략한다. 그 외 값은 모두 운영 환경으로 처리한다
APP_ENV=local
# 운영 환경 필수. Spring이 X-Internal-Secret 헤더로 보내는 값
INTERNAL_SECRET=
# true면 샘플 문서로 검색한다 (로컬 전용, 운영 환경에서는 시작 실패)
USE_SAMPLE_DATA=true

# python main.py의 주소. 비워 두면 로컬은 127.0.0.1, 운영은 0.0.0.0, 포트는 8000
HOST=
PORT=

# TypeSafe JEV API 키
JEV_API_KEY=
# 비워 두면 jev-latest 사용
JEV_MODEL=

# 임베딩 모델 (서비스:모델명). Bedrock은 API 키 없이 AWS 자격 증명과 AWS_REGION을 사용. 서버 계약은 Titan v2 1024차원
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bedrock:amazon.titan-embed-text-v2:0
# 서버 chunks.embedding이 1024차원이라 운영 저장소를 쓰려면 1024여야 함
EMBEDDING_DIMENSIONS=1024

# 노트북 개발용 임베딩 중계 주소 (로컬 전용). 설정하면 위 모델 대신 Titan 중계를 쓰고 INTERNAL_SECRET을 헤더로 보낸다
# SSH 터널 시: http://localhost:18880/api/internal/embeddings
EMBEDDING_PROXY_URL=

# Bedrock 호출 리전. 비워 두면 AWS 기본 설정을 따른다. 서버의 AWS_REGION과 달라도 이 값이 우선한다
BEDROCK_REGION=

# LLM 모델 (서비스:모델명). Bedrock은 API 키 없이 AWS 자격 증명 사용
LLM_API_KEY=
LLM_MODEL=
# 선택. LLM_MODEL이 실패하면 한 번 전환할 모델 (같은 LLM_API_KEY 또는 AWS 자격 증명 사용)
LLM_FALLBACK_MODEL=

# 벡터 저장소 PostgreSQL(pgvector). SSH 터널 시: postgresql://ai_app:비밀번호@localhost:5432/docs199
DATABASE_URL=
# 연결 풀 최대 크기. 비워 두면 10. 서버의 ai_app 연결 수와 동시 요청 수를 보고 정한다
DB_POOL_MAX_SIZE=
# 벡터 검색 cosine distance 최대값. 이 값보다 먼 청크는 근거 후보에서 제외. 0~2, 비워 두면 코드의 기본값
VECTOR_MAX_COSINE_DISTANCE=

# 메모리에 보관할 대화 수와 시간(초). 비워 두면 1000개, 3600초
MAX_CONVERSATIONS=
CONVERSATION_TTL_SECONDS=

# 질문 한 건의 전체 시간 상한(초). 비워 두면 60초. Spring 타임아웃보다 짧게 맞춘다
REQUEST_TIMEOUT_SECONDS=

# 선택적 참조 그래프. 결과는 PostgreSQL 권한 함수에서 본문을 다시 읽는다. 평가 전에는 팀 서버에 설정하지 않는다
# SSH 터널 시: bolt://localhost:7687
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# 요청에 accessScope가 없을 때 쓰는 로컬 시험용 권한 범위. 운영에서는 무시하며, 권한 범위가 없으면 문서를 돌려주지 않는다
# 등급: PUBLIC, INTERNAL, CONFIDENTIAL / 직급: STAFF, SENIOR, MANAGER, DIRECTOR
ACCESS_DEPARTMENT_ID=
ACCESS_POSITION=
ACCESS_CLEARANCE=
ACCESS_IS_ADMIN=
