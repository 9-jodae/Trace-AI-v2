# Local Neo4j and Qdrant endpoints.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local-dev-password
NEO4J_DATABASE=neo4j
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=internal_chunks

# Ollama must be running locally. Pull the embedding model once with:
# ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Optional. Empty uses an extractive, evidence-only summary instead of a chat model.
CHAT_MODEL=
# Set CHAT_PROVIDER=anthropic to send the question and retrieved evidence to Claude.
CHAT_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

CHUNK_SIZE=420
CHUNK_OVERLAP=60
