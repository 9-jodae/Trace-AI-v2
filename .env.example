# TypeSafe JEV API 키
JEV_API_KEY=
# 비워 두면 jev-latest 사용
JEV_MODEL=

# 임베딩 API 키와 모델 (모델 형식: 서비스:모델명, 해당 langchain 패키지 설치 필요)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai:text-embedding-3-large
# Postgres embedding 컬럼의 차원과 같아야 함
EMBEDDING_DIMENSIONS=1536

# LLM API 키와 모델 (모델 형식: 서비스:모델명, 해당 langchain 패키지 설치 필요)
LLM_API_KEY=
LLM_MODEL=

# 비워 두면 벡터 검색에 샘플 데이터 사용 (SSH 터널 사용 시: postgresql://ai_app:비밀번호@localhost:5432/docs199)
DATABASE_URL=
